# Copy this file to .env and change the password. Docker Compose reads .env
# for the Postgres container it starts; consult.config reads the same names
# from the environment first and from .env second. Postgres binds to loopback
# only (docker-compose.yml), so the password guards a local socket and not a
# network. A test keeps this file and consult/config.py naming the same
# settings, so add a setting in both places or neither.
CONSULT_DB_HOST=127.0.0.1
CONSULT_DB_PORT=5432
CONSULT_DB_NAME=consult
CONSULT_DB_USER=consult
CONSULT_DB_PASSWORD=change-me
# The input guards (THREAT_MODEL.md, row 1): an upload over the size cap, a
# responses file over the row cap, a cell over the length cap or an XLSX
# that inflates by more than the ratio, or a row with more fields than
# Excel's own sheet limit, is refused before it is read. The cell and
# column caps are Excel's own limits (docs/01, section 6).
CONSULT_MAX_UPLOAD_BYTES=209715200
CONSULT_MAX_ROWS=250000
CONSULT_MAX_CELL_CHARS=32767
CONSULT_MAX_ZIP_RATIO=100
CONSULT_MAX_COLUMNS=16384
# The cost estimate's assumptions (docs/05, section 1): tokens per open
# answer, prices per million tokens in dollars, and the rate to the pound.
CONSULT_TOKENS_PER_ANSWER=150
CONSULT_USD_PER_MILLION_INPUT=2.00
CONSULT_USD_PER_MILLION_CACHED=0.50
CONSULT_USD_PER_MILLION_OUTPUT=8.00
CONSULT_GBP_PER_USD=0.75
# The two service-wide dispatch caps, alongside department.concurrent_jobs_cap
# (docs/02, step 4): four jobs queued at once for one consultation, twenty
# queued at once across all of them, round-robin across departments when
# contended.
CONSULT_JOBS_PER_CONSULTATION=4
CONSULT_JOBS_IN_ALL=20
# The model alias dispatch stamps on a job that has none. ADR-005 pins the
# alias to the consultation at Confirm; with no Confirm screen here, one
# service-wide setting stands in. A retried job keeps the alias it was
# first given (ADR-002).
CONSULT_MODEL_ALIAS=fake
